<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="NativeBridge Sessionless Test Suite" verbose="1">
    <parameter name="testMode" value="sessionless"/>

    <test name="Smoke Tests - Sessionless Mode">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.AppLaunchTest"/>
        </classes>
    </test>

    <test name="Regression Tests - Sessionless Mode">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.AppLaunchTest"/>
            <class name="tests.DeviceInfoTest"/>
        </classes>
    </test>
</suite>
